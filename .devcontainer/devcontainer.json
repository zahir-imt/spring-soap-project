{
  "name": "StockBridge \u00b7 Java 17",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "false",
      "installGradle": "false"
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "StockBridge dashboard",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "postCreateCommand": "sudo apt-get update -qq && sudo apt-get install -y -qq git-lfs && bash mvnw --batch-mode -DskipTests package"
}
